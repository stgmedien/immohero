# --- Neon Postgres ---
DATABASE_URL=                       # postgres://...neon.tech/...?sslmode=require (pooled)
DATABASE_URL_UNPOOLED=              # direct connection for migrations

# --- Auth.js v5 ---
AUTH_SECRET=                        # `openssl rand -base64 32`
AUTH_URL=http://localhost:3000      # production: https://immohero.org

# --- Resend ---
RESEND_API_KEY=
RESEND_FROM="ImmoHero <team@immohero.org>"
RESEND_REPLY_TO=jonathan@stg-medien.com

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Vercel Blob ---
BLOB_READ_WRITE_TOKEN=

# --- Public site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Wallet (kostenlos; Messe-Gutschein-Pass) ---
# Aus Google Pay & Wallet Console (pay.google.com/business/console) + GCP Service-Account.
GOOGLE_WALLET_ISSUER_ID=            # numerische Issuer-ID
GOOGLE_WALLET_SA_EMAIL=            # service-account@projekt.iam.gserviceaccount.com
GOOGLE_WALLET_SA_PRIVATE_KEY=     # -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# --- Google Calendar (Beratungstermine; kostenlos) ---
# GCP-Projekt mit aktivierter Google Calendar API + OAuth-Client (Web).
# Refresh-Token einmalig via OAuth-Consent für das geteilte Vertriebs-Konto.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary          # oder die ID des geteilten Vertriebs-Kalenders

# --- Optional ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Nur für Source-Map-Upload beim Build (optional, sonst wird es übersprungen):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Cron-Jobs (Vercel ruft mit Bearer-Header auf, lokal/manuell mit ?token=)
CRON_SECRET=

# Analytics (Plausible) — wenn gesetzt, wird das Script geladen
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# WhatsApp via Twilio (optional, gated)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# Pilot Journey Engine (Chat-Guide)
# Claude-API-Key von console.anthropic.com — ohne Key zeigt das Widget einen Setup-Hinweis
ANTHROPIC_API_KEY=
# Optionales Modell-Override (Default claude-sonnet-5)
PILOT_ENGINE_MODEL=
# Voyage-Embeddings fuer semantische Regulatorik-Suche (dash.voyageai.com);
# ohne Key laeuft die deutsche Volltext-Suche als Fallback
VOYAGE_API_KEY=
