# --- Neon Postgres ---
DATABASE_URL=                       # postgres://...neon.tech/...?sslmode=require (pooled)
DATABASE_URL_UNPOOLED=              # direct connection for migrations

# --- Auth.js v5 ---
AUTH_SECRET=                        # `openssl rand -base64 32`
AUTH_URL=http://localhost:3000      # production: https://immohero.org

# --- Resend ---
RESEND_API_KEY=
RESEND_FROM="ImmoHero <team@immohero.org>"
RESEND_REPLY_TO=jonathan@stg-medien.com

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Vercel Blob ---
BLOB_READ_WRITE_TOKEN=

# --- Public site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Wallet (kostenlos; Messe-Gutschein-Pass) ---
# Aus Google Pay & Wallet Console (pay.google.com/business/console) + GCP Service-Account.
GOOGLE_WALLET_ISSUER_ID=            # numerische Issuer-ID
GOOGLE_WALLET_SA_EMAIL=            # service-account@projekt.iam.gserviceaccount.com
GOOGLE_WALLET_SA_PRIVATE_KEY=     # -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# --- Optional ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
